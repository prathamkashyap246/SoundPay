# Copy to .env and edit.

# The exact URL you open in the browser. Passkeys only work on this hostname.
# Laptop only:   http://localhost:3000
# With a phone:  your https tunnel URL, e.g. https://something.trycloudflare.com
ORIGIN=http://localhost:3000
PORT=3000

# Password for opening the POS terminal page.
POS_KEY=change-me
MERCHANT_NAME=Demo Café
CURRENCY=inr

# How long each broadcast token can be claimed (seconds).
SESSION_TTL_SECONDS=30

# Leave these blank for mock-payment mode (no Stripe account needed).
# For Stripe TEST mode: dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

DB_PATH=soundpay.db

# Sound mode: hop (frequency hopping, default), ggwave (original), both (alternate, for older phones).
AUDIO_MODE=hop
# Master secret for hop keys: 64 hex characters. Blank = generated once and kept in the database.
HOP_SECRET=
TERMINAL_ID=pos-1
# fast: ~3 s per broadcast. robust: ~5 s, survives a follower jammer and a second terminal. range: ~4 s, more distance.
HOP_PROFILE=fast
# Several terminals in one shop: this terminal only sends on cycles where cycle % N == k. e.g. 0/2 and 1/2.
TDMA_SLOT=0/1
